<?xml version="1.0"?>
<odoo>
    <data>

        <record model="res.groups" id="group_project_customer_user">
            <field name="name">Project Customer</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <!--
                Module name: this module was renamed from customer_project_user
                to project_customer_user in 18.0.1.0.0, so the group's xmlid is
                now project_customer_user.group_project_customer_user. The
                group's own name (group_project_customer_user) is unchanged —
                only the module prefix moved. The rename is carried by
                migrations/18.0.1.0.0/post-rename_module.py, which re-points
                ir.model.data so this res.groups row (and its
                res_groups_users_rel memberships) is kept, not re-created.
            -->
            <!--
                base.group_user IS implied. The operator's decision
                (2026-10-03) is that the backend is the requirement:
                "vi vill att det ska vara i backend så det måste vara 1".

                A non-internal user cannot run the backend web client at all,
                for two independent reasons found on ledningssystem:

                  1. portal/controllers/web.py redirects every non-internal
                     user from /odoo to /my.
                  2. web/models/ir_http.py only emits `user_companies` in
                     session_info when is_internal_user is true, and the JS
                     client reads `allowed_companies` unconditionally:
                         TypeError: Cannot read properties of undefined
                         (reading 'allowed_companies')

                So the customer is internal again. The over-permission that
                made this group a bypass is NOT solved by withholding the
                group — it is solved by an explicit deny layer on top:
                security/customer_deny.xml denies the model families a
                customer has no business in (ai.*, account.*, hr.*, ir.*,
                res.users, base_import.*, document.*, calendar.*, ...).

                ir.rule domains are ANDed between groups, so a deny rule
                always wins over a grant. This is the mechanism that makes
                "internal user with a narrow surface" work.

                Do NOT imply project.group_project_user: it implies
                base.group_user transitively (harmless now, but it would also
                drag in the full project-manager-adjacent surface). The ACLs
                the customer needs are mirrored from the source groups by
                models/ir_model_access.py.
            -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="customer_read_own_project" model="ir.rule">
            <field name="name">project: only own customer projects visible</field>
            <field name="model_id" ref="project.model_project_project"/>
            <!--
                D5: access is granted by partner_id or customer_ids only.
                message_partner_ids was removed — it is a mail-thread relation
                (anyone ever on the thread), and the module subscribes partners
                as a side effect of write()/create(), so including it meant
                being emailed granted access.
            -->
            <field name="domain_force">['|', ('partner_id','=',user.partner_id.id), ('customer_ids','in',[user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('project_customer_user.group_project_customer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="global" eval="False"/>
        </record>

        <record id="customer_read_own_project_task" model="ir.rule">
            <field name="name">task: only tasks on own customer projects</field>
            <field name="model_id" ref="project.model_project_task"/>
            <!--
                D5: same predicate as the project rule — no message_partner_ids.

                create_uid was added after the operator hit this while saving a
                task as a customer:

                    Tyvärr, Test Kund (id=2347) har inte "läsa" tillgång till:
                    - Aktivitet (project.task)

                The task WAS created; the read-back was denied. Odoo's own rule
                "Project/Task: employees: follow required for followers"
                requires ('user_ids', 'in', user.id) at creation (its comment:
                "to subscribe check access to the record, follower is not
                enough at creation"), and the task form reads the record back
                through web_save before user_ids is committed. Adding
                create_uid here makes the creator's own task readable
                regardless of whether the assignee write has landed yet — which
                is what a regular project user gets.
            -->
            <field name="domain_force">['|', '|', '|',
                ('create_uid', '=', user.id),
                ('partner_id', '=', user.partner_id.id),
                ('project_id.customer_ids', 'in', [user.partner_id.id]),
                ('project_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('project_customer_user.group_project_customer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="global" eval="False"/>
        </record>

        <!--
            mail.message: the customer must be able to read the chatter on
            their own project and tasks.

            Why this rule is needed at all: mail.message has exactly ONE rule
            in a stock database, and it is attached to
            "Tjänsteman: Hantera alla sökande" (hr_recruitment). A customer does
            not hold that group, so *no* rule applies and Odoo denies the whole
            model — verified on ledningssystem 2026-10-03:

                AccessError: Uh-oh! Looks like you have stumbled upon some
                top-secret records.

            Odoo's semantics: a model with rules is readable only through an
            applicable rule. So the customer needs one.

            Scope: messages attached to a project or task the customer can
            already see, plus messages they authored. Nothing else — the
            domain deliberately does not use message_partner_ids, which would
            grant access merely for having been emailed (design D5).
        -->
        <!--
            res.users: a customer may read the user records they need, and no
            more.

            res.users is on the deny-layer whitelist because Odoo reads it
            while building the session — without read access, login itself
            fails. But whitelisting means no deny rule is generated, and the
            stock ACL grants read on the whole table.

            Found on ledningssystem 2026-10-03 with a freshly created customer:
            the user carried Odoo's default groups (including "Administratör"
            and "Användare: Alla dokument"), so res.users was readable in full.

            Scope: the customer's own record, and the users who are partners on
            a project or task they are granted. That is what a task form needs
            to render an assignee avatar.

            The project manager and the assigned users were added after the
            operator hit this while saving a task:

                Access Denied by record rules for operation: read on record
                ids: [150], uid: 2347, model: res.users

            User 150 is the project manager. The task form reads the project's
            user_id to render the "Project Manager" field, so without it the
            form cannot be saved.
        -->
        <record id="customer_read_relevant_users" model="ir.rule">
            <field name="name">res.users: only self and project colleagues</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|',
                ('id', '=', user.id),
                ('partner_id', '=', user.partner_id.id),
                ('partner_id', 'in', user.partner_id.customer_project_ids.customer_ids.ids),
                ('partner_id', 'in', user.partner_id.customer_project_ids.user_id.partner_id.ids),
                ('partner_id', 'in', user.partner_id.customer_project_ids.message_partner_ids.ids),
                ('partner_id', 'in', user.partner_id.customer_task_ids.partner_id.ids),
                ('partner_id', 'in', user.partner_id.customer_task_ids.user_ids.partner_id.ids)]</field>
            <field name="groups" eval="[(4, ref('project_customer_user.group_project_customer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="global" eval="False"/>
        </record>

        <record id="customer_read_own_mail_message" model="ir.rule">
            <field name="name">mail.message: only messages on own projects/tasks</field>
            <field name="model_id" ref="mail.model_mail_message"/>
            <field name="domain_force">['|', '|', '|',
                ('create_uid', '=', user.id),
                '&amp;', ('model', '=', 'project.project'), ('res_id', 'in', user.partner_id.customer_project_ids.ids),
                '&amp;', ('model', '=', 'project.task'), ('res_id', 'in', user.partner_id.customer_task_ids.ids),
                ('author_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('project_customer_user.group_project_customer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="global" eval="False"/>
        </record>

