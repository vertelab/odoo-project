<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <odoo>
    <!-- Search View -->
    <record id="view_prd_document_search" model="ir.ui.view">
      <field name="name">prd.document.search</field>
      <field name="model">prd.document</field>
      <field name="inherit_id" ref="project_prd.view_prd_document_search" />
      <field name="arch" type="xml">
        <field name="state" position="after">
          <field name="app_module" />
          <field name="app_project" />
          <field name="app_tree" />
          <field name="app_summary" />
          <field name="app_category" />
          <field name="app_manifest" />
          <field name="app_license" />
        </field>
        <filter name="group_by_approved_by" position="after">
          <filter string="app_project" name="group_by_app_project" context="{'group_by':'app_project'}" />
          <filter string="App Project" name="group_by_app_project" context="{'group_by':'app_project'}" />
          <filter string="App Tree" name="group_by_app_tree" context="{'group_by':'app_tree'}" />
          <filter string="App Category" name="group_by_app_category" context="{'group_by':'app_category'}" />
          <filter string="App License" name="group_by_app_license" context="{'group_by':'app_license'}" />
        </filter>
      </field>
    </record>
    <!-- Form View -->
    <record id="view_prd_document_form" model="ir.ui.view">
      <field name="name">prd.document.form</field>
      <field name="model">prd.document</field>
      <field name="inherit_id" ref="project_prd.view_prd_document_form" />
      <field name="arch" type="xml">
        <header position="inside">
          <button name="button_export_module" string="Export Module" type="object" class="oe_highlight" groups="project_prd.group_prd_manager" data-hotkey="m" />
        </header>
        <group id="c2" positon="indside">
          <field name="sequence" />
          <field name="app_module" />
          <field name="app_tree" />
          <field name="app_icon" />
          <field name="app_url" />
          <field name="app_banner" />
          <field name="app_summary" />
          <field name="app_category" />
          <field name="app_description" />
          <field name="app_manifest" />
          <field name="app_license" />
          <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" />
          <field name="user_persona" />
          <field name="use_cases" />
          <field name="dependencies" />
        </group>
        <notebook position="inside">
          <page string="Index-file" id="index">
            <field name="app_index" />
          </page>
        </notebook>
      </field>
    </record>
    <!-- List (Tree) View -->
    <record id="view_prd_document_tree" model="ir.ui.view">
      <field name="name">prd.document.module</field>
      <field name="model">prd.document</field>
      <field name="arch" type="xml">
        <list position="inside">
          <field name="sequence" optional="view" />
          <field name="app_project" optional="hide" invisible="not document_type == 'module'" />
          <field name="app_module" optional="hide" invisible="not document_type == 'module'" />
          <field name="app_tree" optional="hide" invisible="not document_type == 'module'" />
          <field name="app_icon" optional="hide" invisible="not document_type == 'module'" />
          <field name="app_url" optional="hide" invisible="not document_type == 'module'" />
          <field name="app_summary" optional="hide" invisible="not document_type == 'module'" />
          <field name="app_category" optional="hide" invisible="not document_type == 'module'" />
          <field name="app_license" optional="hide" invisible="not document_type == 'module'" />
        </list>
      </field>
    </record>
    <!-- Kanban View -->
    <!-- Calendar View -->
    <record id="action_prd_document" model="ir.actions.act_window">
      <field name="name">PRD Documents</field>
      <field name="res_model">prd.document</field>
      <field name="view_mode">kanban,list,form,calendar</field>
      <field name="view_id" ref="view_prd_document_kanban" />
    </record>
    <menuitem id="menu_prd_document_root" name="Product Requirements Docs" sequence="10" />
    <menuitem id="menu_prd_document" name="Product Requirement Documents" parent="menu_prd_document_root" action="action_prd_document" sequence="20" />
    <!-- Menu parent for Configuration -->
    <menuitem id="menu_prd_configuration" name="Configuration" sequence="10" />
    <!-- Views and actions for prd.odoo_branches -->
    <record id="view_prd_odoo_branches_tree" model="ir.ui.view">
      <field name="name">prd.odoo_branches.tree</field>
      <field name="model">prd.odoo_branches</field>
      <field name="arch" type="xml">
        <list>
          <field name="name" />
          <field name="active" />
        </list>
      </field>
    </record>
    <record id="view_prd_odoo_branches_form" model="ir.ui.view">
      <field name="name">prd.odoo_branches.form</field>
      <field name="model">prd.odoo_branches</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name" />
              <field name="active" />
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <record id="view_prd_odoo_branches_search" model="ir.ui.view">
      <field name="name">prd.odoo_branches.search</field>
      <field name="model">prd.odoo_branches</field>
      <field name="arch" type="xml">
        <search>
          <field name="name" />
          <filter string="Active" domain="[('active','=',True)]" />
        </search>
      </field>
    </record>
    <record id="action_prd_odoo_branches" model="ir.actions.act_window">
      <field name="name">Odoo Branches</field>
      <field name="res_model">prd.odoo_branches</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_prd_odoo_branches_search" />
    </record>
    <menuitem id="menu_prd_odoo_branches" name="Odoo Branches" parent="menu_prd_configuration" action="action_prd_odoo_branches" sequence="1" />
