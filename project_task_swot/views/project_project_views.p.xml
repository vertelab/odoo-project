<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Form View -->
    <record id="view_project_project_form" model="ir.ui.view">
        <field name="name">project.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <field name="label_tasks" position="before">
                <div>
                    <field name="is_swot" class="oe_inline oe_input_align"/>
                    <label for="is_swot" class="oe_inline" string="Is Swot"/>
                </div>
            </field>

            <xpath expr="//page[last()]" position="after">
                <page name="project_swot_config" string="SWOT Config" invisible="not is_swot">
                    <group>
                        <group>
                            <field name="x_axis"/>
                            <field name="x_low"/>
                            <field name="y_low"/>
                        </group>
                        <group>
                            <field name="y_axis"/>
                            <field name="x_high"/>
                            <field name="y_high"/>
                        </group>
                    </group>
                </page>
                <page name="project_swot_display" string="SWOT Diagram" invisible="not is_swot">
                    <field name="swot_diagram" widget="mermaid" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
