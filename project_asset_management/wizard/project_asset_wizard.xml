<odoo>
    <data>
        <record id="project_asset_wizard_view_form" model="ir.ui.view">
            <field name="name">project.asset.wizard.view.form</field>
            <field name="model">project.asset.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
<!--                        <h1><field name="employee_id" readonly="1" options="{'no_open': True}"/></h1>-->
                        <group>
                            <group>
                                <field name="project_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}" readonly="1"/>
                                <field name="profile_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                <field name="start_date"/>
                                <field name="purchase_value"/>
                                <field name="company_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="method"/>
                                <field name="method_time"/>
                                <field name="method_period"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_create_asset" string="Create Asset" type="object" class="oe_highlight"/>
                        <button name="action_create_open_asset" string="Create &amp; Open Asset" type="object" class="oe_highlight"/>
                        <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

