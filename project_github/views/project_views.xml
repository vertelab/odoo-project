<odoo>
  <data>
    <record id="edit_project" model="ir.ui.view">
      <field name="name">project.github.form</field>
      <field name="model">project.project</field>
      <field name="inherit_id" ref="project.edit_project" />
      <field name="arch" type="xml">
        <xpath expr="//div[@name='options_active']/div[1]" position="after">
          <div>
            <label for="is_github_repo" class="oe_inline" />
            <field name="is_github_repo" class="oe_inline oe_input_align" />
          </div>
        </xpath>
        <field name="partner_id" position="after">
            <field name="git_owner" attrs="{'invisible': [('is_github_repo', '=', False)]}"/>
            <field name="git_repo" attrs="{'invisible': [('is_github_repo', '=', False)]}"/>
        </field>
        <!--
             <header position="inside">
             <button name="action_show_add_repo" string="Add repo" type="object" attrs="{'invisible': [('is_module_monitor', '=', False)]}" />
             <button name="action_add_stakeholder" string="Add stakeholder" type="object" attrs="{'invisible': [('is_module_monitor', '=', False)]}" />
             </header>
        -->
      </field>
    </record>
<!--
    <record id="task_type_edit" model="ir.ui.view">
      <field name="name">project.task.github.form</field>
      <field name="model">project.task.type</field>
      <field name="inherit_id" ref="project.task_type_edit" />
      <field name="arch" type="xml">
        <field name="sequence" position="after">
          <field name="is_module_odoo" attrs="{'invisible': [('is_github_repo', '=', False)]}" />
          <field name="is_github_repo" invisible="1" />
        </field>
      </field>
    </record>
-->
    <record id="view_task_search_form" model="ir.ui.view">
      <field name="name">project.task.github.search</field>
      <field name="model">project.task</field>
      <field name="inherit_id" ref="project.view_task_search_form" />
      <field name="arch" type="xml">
        <field name="project_id" position="after">
          <field name="module_author" />
          <field name="git_module" />
          <field name="git_repo" />
          <field name="git_owner" />
          <field name="odoo_version" />
          <field name="module_summary" />
          <field name="module_category" />
          <field name="module_website" />
          <field name="module_images" />
          <field name="module_license" />
          <field name="module_maintainer" />
          <field name="module_depends" />
          <field name="module_installable" />
          <field name="module_application" />
          <field name="module_auto_install" />
          <field name="module_branches" />
        </field>
        <filter name="my_tasks" position="after">
          <!--
               <filter string="Is Module Monitor" name="module_monitor" domain="[('is_module_monitor', '=', True)]" />
          -->
          <filter string="Is Installable" name="module_installable" domain="[('module_installable', '=', True)]" />
          <filter string="Is Application" name="module_application" domain="[('module_application', '=', True)]" />
          <filter string="Has Auto Install" name="module_auto_install" domain="[('module_auto_install', '=', True)]" />
        </filter>
        <xpath expr="//group" position="inside">
          <filter string="Author" name="author" context="{'group_by': 'module_author'}" />
          <filter string="Version" name="odoo_version" context="{'group_by': 'odoo_version'}" />
          <filter string="Module Category" name="module_category" context="{'group_by': 'module_category'}" />
          <filter string="License" name="license" context="{'group_by': 'module_license'}" />
          <filter string="Maintainer" name="maintainer" context="{'group_by': 'module_maintainer'}" />
        </xpath>
      </field>
    </record>
    <record id="view_task_tree2" model="ir.ui.view">
      <field name="name">project.task.github.tree</field>
      <field name="model">project.task</field>
      <field name="inherit_id" ref="project.view_task_tree2" />
      <field name="arch" type="xml">
        <field name="user_id" position="after">
          <field name="module_author" optional="hide" />
          <field name="module_author" optional="hide" />
          <field name="git_repo" optional="hide" />
          <field name="git_module" optional="hide" />
          <field name="odoo_version" optional="hide" />
          <field name="module_summary" optional="hide" />
          <field name="module_category" optional="hide" />
          <field name="module_website" optional="hide" />
          <field name="module_images" optional="hide" />
          <field name="module_license" optional="hide" />
          <field name="module_maintainer" optional="hide" />
          <field name="module_depends" optional="hide" />
          <field name="module_installable" optional="hide" />
          <field name="module_application" optional="hide" />
          <field name="module_auto_install" optional="hide" />
          <field name="module_branches" optional="hide" />
          <field name="is_module_odoo" optional="hide" />
        </field>
      </field>
    </record>
    <record id="view_task_form2" model="ir.ui.view">
      <field name="name">project.task.github.form</field>
      <field name="model">project.task</field>
      <field name="inherit_id" ref="project.view_task_form2" />
      <field name="arch" type="xml">
          <header position="inside">
          <button name="get_module_info" string="Module Info" type="object" class="oe_highlight" attrs="{'invisible' : [('is_module_odoo', '=', False)]}"/>
          </header>
          <field name="active" position="after">
              <field name="is_github_repo" invisible="1"/>
              <field name="is_module_odoo" attrs="{'invisible': [('is_github_repo', '=', False)]}"/>
          </field>
        <notebook position="inside">
          <page name="odoo_module" string="Odoo Module" attrs="{'invisible': [('is_module_odoo', '=', False)]}">
            <group>
              <group>
                <field name="module_author" />
                <field name="git_repo" />
                <field name="git_module" />
                <field name="odoo_version" />
                <field name="module_summary" />
                <field name="module_category" />
                <field name="module_website" />
                <field name="module_images" />
                <field name="module_license" />
              </group>
              <group>
                <field name="module_maintainer" />
                <field name="module_depends" />
                <field name="module_installable" />
                <field name="module_application" />
                <field name="module_auto_install" />
                <field name="module_branches" />
                <field name="is_module_odoo" invisible="1" />
              </group>
              <field name="module_website_desc" />
            </group>
          </page>
        </notebook>
      </field>
    </record>
    <record id="view_project_kanban" model="ir.ui.view">
      <field name="name">project.github.main.kanban</field>
      <field name="model">project.project</field>
      <field name="inherit_id" ref="project.view_project_kanban" />
      <field name="arch" type="xml">
        <field name="name" position="after">
          <field name="is_github_repo" />
        </field>
      </field>
    </record>
  </data>
</odoo>
