<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Search View -->
    <record id="view_task_search_form" model="ir.ui.view">
        <field name="name">task.search.task.number</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <!-- Fritextsokning matchar aven T-numret (T/11522 och 11522).
                     Utan filter_domain matchar Odoos fria sokfalt bara
                     display_name (= namnet), sa numret gick inte att soka pa. -->
                <field name="number"
                       filter_domain="['|', ('number', 'ilike', self), ('number', 'ilike', 'T/' + self)]" />
            </field>
        </field>
    </record>

    <!-- Inherit Form View -->
    <record id="view_task_form_task_number" model="ir.ui.view">
        <field name="name">task.form.task.number</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <field name="priority" position="replace">
                <field name="priority" widget="priority_switch" class="me-3" />
                <span class="text-muted small" style="white-space: nowrap;">
                    [<field name="number" />]
                </span>
            </field>
        </field>
    </record>

    <!-- Inherit List View -->
    <record id="view_task_tree2" model="ir.ui.view">
        <field name="name">task.tree.task.number</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <field name="sequence" position="after">
                <field name="number" />
            </field>
        </field>
    </record>

    <!-- Inherit Kanban View -->
    <record id="view_task_kanban_task_number" model="ir.ui.view">
        <field name="name">task.kanban.task.number</field>
        <field name="model">project.task</field>
        <!-- 20.0 split the kanban into an empty <kanban> and a <card> view
             (project.view_task_card). The card is where the fields live, so
             the inheritance has to target it. -->
        <field name="inherit_id" ref="project.view_task_card" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <span class="text-muted small me-1 text-nowrap flex-shrink-0">[<field name="number"/>]</span>
            </field>
        </field>
    </record>
</odoo>
