<odoo>
  <data>
    <record id="view_task_form2" model="ir.ui.view">
      <field name="name">project.task.form.inherit.equity</field>
      <field name="model">project.task</field>
      <field name="inherit_id" ref="project.view_task_form2" />
      <field name="arch" type="xml">
        <field name="name" position="after">
          <field name="is_equity_portfolio" invisible="1" />
        </field>
        <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
          <button name="action_open_equity_prices" type="object" class="oe_stat_button" icon="fa-line-chart" string="Equity Prices" invisible="not is_equity_portfolio">
            <field name="equity_price_count" widget="statinfo" string="Prices" />
          </button>
          <button name="action_open_equity_research" type="object" class="oe_stat_button" icon="fa-search" string="Equity Research" invisible="not is_equity_portfolio">
            <field name="equity_research_count" widget="statinfo" string="Research" />
          </button>
          <button name="action_open_transactions" type="object" class="oe_stat_button" icon="fa-search" string="Transactions" invisible="not is_equity_portfolio">
            <field name="transaction_count" widget="statinfo" string="Transactions" />
          </button>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
