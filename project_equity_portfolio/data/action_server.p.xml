<odoo>
  <!-- Server Action -->
  <record id="action_get_latest_news" model="ir.actions.server">
    <field name="name">Get Latest Equity News</field>
    <field name="model_id" ref="project.model_project_project"/>
    <field name="state">code</field>
    <field name="code">
        for r in records:
            if r.is_equity_portfolio:
                r.get_latest_news()
    </field>
  </record>

  <!-- Scheduled Action (Cron Job) -->
  <record id="ir_cron_get_latest_news" model="ir.cron">
    <field name="name">Scheduled Get Latest Equity News</field>
    <field name="model_id" ref="project.model_project_project"/>
    <field name="state">code</field>
    <field name="code">
        for r in records:
            if r.is_equity_portfolio:
                r.get_latest_news()
</field>
    <field name="interval_type">hours</field>
    <field name="interval_number">1</field>
    <field name="numbercall">-1</field> 
    <field name="doall" eval="False"/>
    <field name="active" eval="True"/>
  </record>
</odoo>
