<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kostnadskontext-vyer (session-cost-context 7.x). Domänfälten
         project_id/task_id finns bara när project_ai är installerat;
         vyerna ärver core-vyerna (Odoo 18: list, aldrig tree). -->

    <!-- Session-list: kolumner för kostnadskontext -->
    <record id="view_ai_session_list_project" model="ir.ui.view">
        <field name="name">ai.coworker.session.list.project</field>
        <field name="model">ai.coworker.session</field>
        <field name="inherit_id" ref="ai_agent_core.view_ai_session_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='coworker_id']" position="after">
                <field name="project_id" optional="show"/>
                <field name="task_id" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="pi_session_id" optional="hide"/>
                <field name="cost_context_confirmed" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Session-form: kontextfälten read-only -->
    <record id="view_ai_session_form_project" model="ir.ui.view">
        <field name="name">ai.coworker.session.form.project</field>
        <field name="model">ai.coworker.session</field>
        <field name="inherit_id" ref="ai_agent_core.view_ai_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="cost_context" string="Kostnadskontext">
                    <group>
                        <field name="project_id" readonly="1"/>
                        <field name="task_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="pi_session_id" readonly="1"/>
                        <field name="cost_context_confirmed" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Pivot: kostnadsuppföljning per kund/projekt (D6) -->
    <record id="view_ai_session_pivot" model="ir.ui.view">
        <field name="name">ai.coworker.session.pivot</field>
        <field name="model">ai.coworker.session</field>
        <field name="arch" type="xml">
            <pivot string="AI-kostnadsuppföljning">
                <field name="partner_id" type="row"/>
                <field name="project_id" type="col"/>
                <field name="token_input" type="measure"/>
                <field name="token_output" type="measure"/>
                <field name="token_sys" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_ai_session_cost_pivot" model="ir.actions.act_window">
        <field name="name">AI-kostnadsuppföljning</field>
        <field name="res_model">ai.coworker.session</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_id" ref="view_ai_session_pivot"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                AI-kostnader per kund och projekt — aggregerade tokens från
                sessionerna.
            </p>
        </field>
    </record>

    <menuitem id="menu_ai_session_cost_pivot"
              name="AI-kostnadsuppföljning"
              parent="ai_agent_core.menu_ai_session"
              action="action_ai_session_cost_pivot"
              sequence="10"/>

    <!-- Smartknapp på project.project (7.4) -->
    <record id="view_project_project_form_ai_sessions" model="ir.ui.view">
        <field name="name">project.project.form.ai.sessions</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_ai_sessions" type="object"
                        class="oe_stat_button" icon="fa-bolt">
                    <div class="o_stat_info">
                        <field name="ai_session_count" widget="statinfo"
                               string="AI-sessioner"/>
                        <field name="ai_token_total" widget="statinfo"
                               string="Tokens"/>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Smartknapp på res.partner (7.5) -->
    <record id="view_res_partner_form_ai_sessions" model="ir.ui.view">
        <field name="name">res.partner.form.ai.sessions</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_ai_sessions" type="object"
                        class="oe_stat_button" icon="fa-bolt">
                    <div class="o_stat_info">
                        <field name="ai_session_count" widget="statinfo"
                               string="AI-sessioner"/>
                        <field name="ai_token_total" widget="statinfo"
                               string="Tokens"/>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
