<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Artefakttyper för projektbryggan (okf-mixin D12). -->
        <record id="artifact_type_project_project" model="ai.artifact.type">
            <field name="name">project_project</field>
            <field name="kind">knowledge</field>
            <field name="bridge_module">project_ai</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'none', 'retention_days': 0}"/>
        </record>
        <record id="artifact_type_project_task" model="ai.artifact.type">
            <field name="name">project_task</field>
            <field name="kind">knowledge</field>
            <field name="bridge_module">project_ai</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'none', 'retention_days': 0}"/>
        </record>
    </data>
</odoo>
