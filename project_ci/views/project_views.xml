<odoo>
    <data>

        <record id="edit_project" model="ir.ui.view">
            <field name="name">project.project.form.create.project.cis.button</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <header position="inside">
                    <button name="create_project_ci" string="Run CI Tests" type="object" attrs="{'invisible': [('is_odoo_project', '=', False)]}"/>
                </header>
                <div class="oe_button_box" position="inside">
                    <button class="oe_stat_button" name="project_ci_action" type="object" icon="fa-file-text-o" attrs="{'invisible': [('count_project_ci', '=', 0)]}">
                        <field string="CI" name="count_project_ci" widget="statinfo"/>
                    </button>
                    <button class="oe_stat_button" name="project_ci_branch_action" type="object" icon="fa-file-text-o" attrs="{'invisible': [('count_project_ci_branch', '=', 0)]}">
                        <field string="CI Branches" name="count_project_ci_branch" widget="statinfo"/>
                    </button>
                </div>
                <field name="label_tasks" position="after">
                    <div>
                        <label for="is_odoo_project" class="oe_inline" string="is odoo project"/>
                        <field name="is_odoo_project" string="is odoo project"/>
                        <field name="project_ci_branch_name_ids" widget="many2many_tags" attrs="{'invisible': [('is_odoo_project', '=', False)]}"/>
                    </div>
                </field>
            </field>
        </record>

    </data>
</odoo>