<odoo>
    <data>

  <record id="project_ci_branch_line_form_view" model="ir.ui.view">
            <field name="name">project.ci.branch.line.form.view</field>
            <field name="model">project.ci.branch.line</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="create_task" string="Create Task"  type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="project_ci_branch_id"/>
                                <field name="line_type"/>
                            </group>
                            <group>
                                <field name="text"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
