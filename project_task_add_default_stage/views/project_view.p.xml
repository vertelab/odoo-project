<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- #if VERSION <= "19.0" -->
    <!-- 20.0's simplified project form is title + date only; the settings
         container it used to carry is gone. The setting is already added to
         edit_project below, which is the form users actually configure from. -->
    <record id="project_project_view_form_default" model="ir.ui.view">
        <field name="name">project.project.view.form.default</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_settings_container')]" position="inside">
                <setting string="Default Types" help="Sets defult stages for project">
                    <field name="use_default_types"/>
                </setting>
            </xpath>
        </field>
    </record>
    <!-- #endif -->

    <record id="edit_project_default" model="ir.ui.view">
        <field name="name">project.project.default.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="use_default_types"/>
            </field>
        </field>
    </record>
</odoo>
