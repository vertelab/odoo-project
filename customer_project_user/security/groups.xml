        <!--
            ============================================================
            Framework ACL tail (design D3)
            ============================================================

            A /odoo backend session needs read access to framework models or
            it does not deny gracefully — it crashes or renders a blank page.
            These rows replace what was previously inherited from
            base.group_user. They are deliberately read-only unless noted.

            Derived by negative discovery (task 9) plus the explicit list in
            design D3. Keep this list minimal: everything the customer can
            reach here is reachable by URL.
        -->

        <!-- Model metadata: the web client reads these to decide what to render -->
        <record model="ir.model.access" id="access_ir_model_customer">
            <field name="name">ir.model for project customer</field>
            <field name="model_id" ref="base.model_ir_model"/>
            <field name="group_id" ref="customer_project_user.group_project_customer_user"/>
            <field name="perm_read">1</field>
        </record>

