        <record model="ir.model.access" id="access_project_sprint_type_customer">
            <field name="name">project.sprint.type for project customer</field>
            <field name="model_id" ref="project_scrum.model_project_sprint_type"/>
            <field name="group_id" ref="customer_project_user.group_project_customer_user"/>
            <field name="perm_read">1</field>
