<?xml version="1.0"?>
<odoo>
    <data>

        <record model="res.groups" id="group_project_customer_user">
            <field name="name">Project Customer</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <!--
                No implied_ids on purpose.

                This group must NOT imply base.group_user: that grants the
                customer the full internal-user surface (460 ACL rows on
                ledningssystem, 2026-10-03) and makes them internal, which is
                what leaked customer addresses into internal mail threads.

                It must NOT imply project.group_project_user either: that group
                itself implies base.group_user, so the bypass would come back
                transitively.

                Instead, the ACLs the customer needs are mirrored from the
                source groups by the mirror mechanism (see
                models/ir_model_access.py) without taking the implication.
            -->
        </record>

        <record id="customer_read_own_project" model="ir.rule">
            <field name="name">project: only own customer projects visible</field>
            <field name="model_id" ref="project.model_project_project"/>
            <!--
                D5: access is granted by partner_id or customer_ids only.
                message_partner_ids was removed — it is a mail-thread relation
                (anyone ever on the thread), and the module subscribes partners
                as a side effect of write()/create(), so including it meant
                being emailed granted access.
            -->
            <field name="domain_force">['|', ('partner_id','=',user.partner_id.id), ('customer_ids','in',[user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('customer_project_user.group_project_customer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="global" eval="False"/>
        </record>

        <record id="customer_read_own_project_task" model="ir.rule">
            <field name="name">task: only tasks on own customer projects</field>
            <field name="model_id" ref="project.model_project_task"/>
            <!-- D5: same predicate as the project rule — no message_partner_ids. -->
            <field name="domain_force">['|', '|', ('partner_id', '=', user.partner_id.id), ('project_id.customer_ids','in',[user.partner_id.id]), ('project_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('customer_project_user.group_project_customer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="global" eval="False"/>
        </record>

        <record id="group_mail_message_subtype_project_customer_rule" model="ir.rule">
            <field name="name">mail.subtype: hide internal subtypes</field>
            <field name="model_id" ref="mail.model_mail_message_subtype"/>
            <field name="domain_force">[('internal', '=', False)]</field>
            <field name="groups" eval="[(4, ref('customer_project_user.group_project_customer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="global" eval="False"/>
        </record>

        <record id="group_compose_message_project_customer_rule" model="ir.rule">
            <field name="name">mail.compose: only own messages</field>
            <field name="model_id" ref="mail.model_mail_compose_message"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('customer_project_user.group_project_customer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="global" eval="False"/>
        </record>

