            <field name="name">ir.model.access for project customer</field>
            <field name="model_id" ref="base.model_ir_model_access"/>
            <field name="group_id" ref="customer_project_user.group_project_customer_user"/>
            <field name="perm_read">1</field>
        </record>

        <!-- Views, menus and actions: without these the client cannot build a page -->
        <record model="ir.model.access" id="access_ir_ui_view_customer">
            <field name="name">ir.ui.view for project customer</field>
            <field name="model_id" ref="base.model_ir_ui_view"/>
            <field name="group_id" ref="customer_project_user.group_project_customer_user"/>
