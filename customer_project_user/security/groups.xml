<?xml version="1.0"?>
<odoo>
    <data>

        <record model="res.groups" id="group_project_customer_user">
            <field name="name">Project Customer</field>
            <field name="category_id" ref="base.module_category_services_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="customer_read_own_project" model="ir.rule">
            <field name="name">project: only own customer projects visible</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">['|', '|', ('partner_id','=',user.partner_id.id), ('customer_ids','in',[user.partner_id.id]), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('customer_project_user.group_project_customer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="global" eval="False"/>
        </record>

        <record id="customer_read_own_project_task" model="ir.rule">
            <field name="name">task: only tasks on own customer projects</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">['|', '|', ('partner_id', '=', user.partner_id.id), ('project_id.customer_ids','in',[user.partner_id.id]), ('project_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('customer_project_user.group_project_customer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="global" eval="False"/>
        </record>

        <record id="group_mail_message_subtype_project_customer_rule" model="ir.rule">
            <field name="name">mail.subtype: hide internal subtypes</field>
            <field name="model_id" ref="mail.model_mail_message_subtype"/>
            <field name="domain_force">[('internal', '=', False)]</field>
            <field name="groups" eval="[(4, ref('customer_project_user.group_project_customer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="global" eval="False"/>
        </record>

        <record id="group_compose_message_project_customer_rule" model="ir.rule">
            <field name="name">mail.compose: only own messages</field>
            <field name="model_id" ref="mail.model_mail_compose_message"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('customer_project_user.group_project_customer_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="global" eval="False"/>
        </record>

        <!-- project_scrum ACLs (module only grants to project groups, not base.group_user) -->
        <record model="ir.model.access" id="access_project_scrum_us_customer">
            <field name="name">project.scrum.us for project customer</field>
            <field name="model_id" ref="project_scrum.model_project_scrum_us"/>
            <field name="group_id" ref="customer_project_user.group_project_customer_user"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record model="ir.model.access" id="access_project_scrum_sprint_customer">
