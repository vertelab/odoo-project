<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <odoo>
    <!-- Form View -->
    <record id="view_prd_document_form" model="ir.ui.view">
      <field name="name">prd.document.form</field>
      <field name="model">prd.document</field>
      <field name="inherit_id" ref="project_prd.view_prd_document_form" />
      <field name="arch" type="xml">
        <header position="inside">
<!--
          <button name="action_excel_wizard" string="Load Requirements" type="object" class="oe_highlight" groups="project_prd.group_prd_manager" data-hotkey="m" />
-->
          <button name="action_excel_wizard" string="Load Requirements" type="object" class="oe_highlight"  data-hotkey="m" />
        </header>
      </field>
    </record>
    <record id="excel_wizard_view" model="ir.ui.view">
      <field name="name">prd.excel.wizard.view</field>
      <field name="model">prd.excel.wizard</field>
      <field name="arch" type="xml">
        <form string="Warning">
          <group>
            <field name="file" />
          </group>
          <footer>
            <button name="import_excel" string="Import" type="object" class="oe_highlight" />
            <button name="cancel" string="Cancel" special="cancel" />
          </footer>
        </form>
      </field>
    </record>
  </odoo>
</odoo>
