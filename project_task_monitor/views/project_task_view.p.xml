<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="task_type_edit" model="ir.ui.view">
    <field name="name">project.task.type.form.monitor</field>
    <field name="model">project.task.type</field>
    <field name="inherit_id" ref="project.task_type_edit" />
    <field name="arch" type="xml">
      <sheet position="inside">
        <notebook>
          <page id="trigger" string="Trigger">
            <group>
              <field name="trigger_type" />
              <field name="esc_user" invisible="trigger_type != 'esc'"/>
              <field name="activity_type" invisible="trigger_type != 'activity'"/>
              <field name="summary" invisible="trigger_type != 'activity'"/>
              <field name="message" invisible="trigger_type != 'message'"/>
            </group>
          </page>
          <page id="code" string="Code" invisible="trigger_type != 'code'">
            <field name="code" widget="text" />
          </page>
        </notebook>
      </sheet>
    </field>
  </record>
</odoo>
