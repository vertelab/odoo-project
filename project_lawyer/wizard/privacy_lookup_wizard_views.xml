<odoo>
	<data>

		<record id="privacy_lookup_wizard_view_tree" model="ir.ui.view">
			<field name="name">privacy.lookup.wizard.view.tree</field>
			<field name="model">privacy.lookup.wizard</field>
			<field name="arch" type="xml">
				<tree string="Privacy Lookup Stakeholders">
					<field name="email" />
					<field name="name" />
					<field name="is_reviewed"/>
				</tree>
			</field>
		</record>

		<record id="privacy_lookup_wizard_line_view_tree_add_manual_evaluation_button" model="ir.ui.view">
			<field name="name">privacy.lookup.wizard.line.view.tree.inherit</field>
            <field name="model">privacy.lookup.wizard.line</field>
            <field name="inherit_id" ref="privacy_lookup.privacy_lookup_wizard_line_view_tree"/>
            <field name="arch" type="xml">
				<tree create="0" position="inside">
		    		<header>
                    	<button string="Confirm Manual Review" name="action_confirm_manual_review" type="object" class="oe_highlight" display="always"/>
                	</header>
				</tree>
            </field>
		</record>

		<record id="action_privacy_lookup_wizard_stakeholders" model="ir.actions.act_window">
			<field name="name">Privacy Lookup Stakeholders</field>
			<field name="res_model">privacy.lookup.wizard</field>
			<field name="view_mode">tree,form</field>
			<field name="view_id" ref="privacy_lookup_wizard_view_tree"/>
			<field name="target">current</field>
    	</record>

	</data>
</odoo>
