<odoo>
  <data>
    <record id="edit_project" model="ir.ui.view">
      <field name="name">project.lawyer.form</field>
      <field name="model">project.project</field>
      <field name="inherit_id" ref="project.edit_project" />
      <field name="arch" type="xml">
          
        <xpath expr="//div[@class='oe_title']" position="inside">
            <label for="is_lawyer" class="oe_inline" />
            <field name="is_lawyer" class="oe_inline oe_input_align" />
        </xpath>
        <field name="partner_id" position="after">
          <field name="stakeholder_ids" widget="many2many_tags" invisible="is_lawyer == False" />
        </field>
        <field name="date" position="after">
            <field name="counterpart_id" invisible="is_lawyer == False" />
        </field>
        <header position="inside">
          <field name="is_reviewed_customer_COI" invisible="1"/>
          <field name="is_reviewed_counterpart_COI" invisible="1"/>
          <field name="is_reviewed_stakeholders_COI" invisible="1"/>

          <button name="action_privacy_lookup_customer" string="Check Customer COI" type="object" invisible="is_lawyer == False or is_reviewed_customer_COI == True" />
          <button name="action_privacy_lookup_customer" string="Check Customer COI" type="object" invisible="is_lawyer == False or is_reviewed_customer_COI == False" class="oe_highlight disabled"/>

          <button name="action_privacy_lookup_counterpart" string="Check Counterpart COI" type="object" invisible="is_lawyer == False or is_reviewed_counterpart_COI == True" />
          <button name="action_privacy_lookup_counterpart" string="Check Counterpart COI" type="object" invisible="is_lawyer == False or is_reviewed_counterpart_COI == False" class="oe_highlight disabled" />

          <button name="action_privacy_lookup_stakeholders" string="Check Stakeholder COI" type="object" invisible="is_lawyer == False or is_reviewed_stakeholders_COI == True" />
          <button name="action_privacy_lookup_stakeholders" string="Check Stakeholder COI" type="object" invisible="is_lawyer == False or is_reviewed_stakeholders_COI == False" class="oe_highlight disabled" />
          
        </header>
        <notebook position="inside">
          <page string="Lawyer info" invisible="is_lawyer == False" />
        </notebook>
      </field>
    </record>
  </data>
</odoo>
