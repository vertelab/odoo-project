<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="project_add_stakeholder_wizard_view" model="ir.ui.view">
            <field name="name">project_add_stakeholder_wizard_view</field>
            <field name="model">project.add.stakeholder.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="project_id" />
                            <field name="partner_id" />
                            <field name="stakeholder_file" />
                        </group>
                        <footer>
                            <button string="Load file" type="object" class="oe_highlight" name="load_file" />
                            <button string="Cancel" class="btn-secondary" special="cancel" />
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_project_add_stakeholder_wizard_view" model="ir.actions.act_window">
            <field name="name">Load modules</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.module.monitor.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="project_module_monitor_wizard_view" />
            <field name="target">new</field>
        </record>
    </data>
</odoo>
