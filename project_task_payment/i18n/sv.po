#. module: project_task_payment
#: model:ir.model.fields,help:project_task_payment.field_project_task__payment_partner_id
msgid ""
"Person who should receive the payment for this task. This is NOT the task's "
"customer (partner_id); it is the employee or vendor being compensated."
msgstr ""
"Person som ska ta emot betalningen för denna uppgift. Detta är INTE "
"uppgiftens kund (partner_id), utan den medarbetare eller leverantör som ska "
"ersättas."

#. module: project_task_payment
#. odoo-python
#: code:addons/project_task_payment/models/project_task.py:0
msgid "Please set a payment recipient on the task before creating a payment."
msgstr "Ange en betalningsmottagare på uppgiften innan du skapar en betalning."

#. module: project_task_payment
#: model:ir.model.fields,field_description:project_task_payment.field_project_task__show_payment_button
msgid "Show Create Payment Button"
msgstr "Visa skapa betalning knapp"

