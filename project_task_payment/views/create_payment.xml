<odoo>
  <!-- Stage configuration: the create_payment flag -->
  <record id="task_type_edit" model="ir.ui.view">
    <field name="name">project.task.type.form.create.payment</field>
    <field name="model">project.task.type</field>
    <field name="inherit_id" ref="project.task_type_edit" />
    <field name="arch" type="xml">
      <field name="fold" position="after">
        <field name="create_payment" />
      </field>
    </field>
  </record>

  <!-- Task form: header button + stat button + recipient + payments page -->
  <record id="view_task_form2" model="ir.ui.view">
    <field name="name">project.task.form.create.payment</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2" />
    <field name="arch" type="xml">
      <field name="stage_id" position="after">
        <button name="action_create_payment"
                string="Create Payment"
                type="object"
                class="oe_highlight"
                groups="account.group_account_invoice"
                invisible="not show_payment_button" />
        <field name="show_payment_button" invisible="1" />
      </field>
      <field name="partner_id" position="after">
        <field name="payment_partner_id"
               widget="res_partner_many2one"
               options="{'no_quick_create': True}"
               invisible="not show_payment_button" />
      </field>
      <span id="end_button_box" position="before">
        <button name="action_create_payment"
                type="object"
                class="oe_stat_button"
                icon="fa-money"
                groups="account.group_account_invoice"
                invisible="not payment_count">
          <field name="payment_count" widget="statinfo" string="Payments" />
        </button>
      </span>
      <page name="description_page" position="after">
        <page name="payments_page" string="Payments" invisible="not payment_ids">
          <field name="payment_ids" readonly="1">
            <list>
              <field name="date" />
              <field name="name" />
              <field name="partner_id" />
              <field name="journal_id" />
              <field name="amount_company_currency_signed" string="Amount" />
              <field name="state" widget="badge" />
            </list>
          </field>
        </page>
      </page>
    </field>
  </record>

  <!-- Task kanban: keep the button, but only for users allowed to create payments -->
  <record id="view_task_kanban" model="ir.ui.view">
    <field name="name">project.task.kanban.create.payment</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_kanban" />
    <field name="arch" type="xml">
      <field name="state" position="after">
        <field name="show_payment_button" />
      </field>
      <field name="user_ids" position="before">
        <button name="action_create_payment"
                string="Create Payment"
                type="object"
                class="oe_highlight"
                groups="account.group_account_invoice"
                invisible="not show_payment_button" />
      </field>
    </field>
  </record>

  <!-- Payment form: show which task the payment belongs to -->
  <record id="view_account_payment_form" model="ir.ui.view">
    <field name="name">account.payment.form.task</field>
    <field name="model">account.payment</field>
    <field name="inherit_id" ref="account.view_account_payment_form" />
    <field name="arch" type="xml">
      <field name="memo" position="after">
        <field name="task_id"
               readonly="1"
               invisible="not task_id"
               options="{'no_open': False}" />
      </field>
    </field>
  </record>
</odoo>
